#!/usr/bin/env python3
"""Scan /nearline for your groups (owner, size and tape state of every file) and refresh the shared copies in
var/stats/ of this repo (the scan plus the nightly robinhood stats).

Run on a login node, where /nearline is mounted; JupyterHub sessions on compute nodes read the copy.
Daily cron on login1 (Alliance writes the files at about 01:00 Fir time):
    0 3 * * * /project/def-kanj241/A01_GAIG_data_repo/C01_pipelines/fir-dashboard/bin/firdash-refresh-stats
"""
import os
import sys
import time

REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, REPO)
from firdash import collectors as c  # noqa: E402

if not os.path.isdir("/nearline/.stats"):
    sys.exit("/nearline is not mounted here; run this on a login node.")
done = []
for g in c.groups():
    d = c.fs_stats("nearline", g)
    if d["stats"]:
        sc = d.get("scan")
        done.append(f"{g} ({d['source']}" + (f", {sc['files']:,} files" if sc else "") + ")")
print(time.strftime("%Y-%m-%d %H:%M"), "refreshed /nearline stats for:", ", ".join(done) or "no group")
